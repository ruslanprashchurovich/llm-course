# Скопируйте в .env и поправьте под себя.
# Каждая переменная соответствует полю Settings (app/config.py) с префиксом APP_.

APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO

APP_QDRANT_URL=http://127.0.0.1:6333
APP_QDRANT_COLLECTION=internal_docs

APP_OLLAMA_BASE_URL=http://127.0.0.1:11434
APP_LLM_MODEL=qwen2.5:3b
APP_LLM_TEMPERATURE=0.2
# Thinking-модели (qwen3.5+) по умолчанию рассуждают перед ответом — для RAG
# это лишние секунды; false безопасен и для моделей без thinking (qwen2.5:3b).
APP_LLM_THINK=false
# Контекст на ОДИН запрос (system + чанки + вопрос + ответ). Дефолт Ollama 4096
# для RAG впритык; при переполнении сервер молча режет начало промпта.
# Замер на RTX 5050 8 ГБ + qwen3.5:9b: 4096/6144 -> 100% GPU, 8192 -> 12% слоёв на CPU
# (скорость в прогоне не просела: 22-26 ток/с). Мало VRAM - ставьте 6144.
APP_LLM_NUM_CTX=8192

# Выключите, если не хотите скачивать cross-encoder (~500 МБ):
APP_RERANKER_ENABLED=true

APP_SEARCH_TOP_K=5
APP_SEARCH_FETCH_K=20
